  "curriculum": [
    {
      "id": "cur-101",
      "class_id": "cls-10",
      "subject_id": "sub-101",
      "title": "Chapter 1: Real Numbers",
      "description": "Fundamental Theorem of Arithmetic, decimal expansions of rational numbers.",
      "topics": [
        "Introduction & Euclid's Division Lemma",
        "Fundamental Theorem of Arithmetic",
        "Revisiting Irrational Numbers & Decimals",
        "Decimal Expansions of Rational Numbers"
      ],
      "completed_topics": 3,
      "target_term": "Mid-Term Exam",
      "instructor": "R. Sharma",
      "published_to_students": true
    },
    {
      "id": "cur-102",
      "class_id": "cls-10",
      "subject_id": "sub-101",
      "title": "Chapter 2: Polynomials",
      "description": "Geometrical meaning of zeroes, relationship between zeroes and coefficients.",
      "topics": [
        "Geometrical Meaning of Zeroes of a Polynomial",
        "Relationship between Zeroes and Coefficients",
        "Division Algorithm for Polynomials"
      ],
      "completed_topics": 3,
      "target_term": "Mid-Term Exam",
      "instructor": "R. Sharma",
      "published_to_students": true
    },
    {
      "id": "cur-103",
      "class_id": "cls-10",
      "subject_id": "sub-101",
      "title": "Chapter 3: Pair of Linear Equations",
      "description": "Graphical and algebraic methods of solving linear systems.",
      "topics": [
        "Graphical Method of Solution of Linear Equations",
        "Algebraic Methods: Substitution & Elimination",
        "Equations Reducible to a Pair of Linear Equations"
      ],
      "completed_topics": 1,
      "target_term": "Mid-Term Exam",
      "instructor": "R. Sharma",
      "published_to_students": true
    },
    {
      "id": "cur-104",
      "class_id": "cls-10",
      "subject_id": "sub-101",
      "title": "Chapter 4: Quadratic Equations",
      "description": "Standard form, factorization, quadratic formula.",
      "topics": [
        "Quadratic Equations & Roots by Factorisation"
      ],
      "completed_topics": 0,
      "target_term": "Mid-Term Exam",
      "instructor": "R. Sharma",
      "published_to_students": true
    },
    {
      "id": "cur-105",
      "class_id": "cls-10",
      "subject_id": "sub-103",
      "title": "Unit 1: Optics & Ray Reflection",
      "description": "Reflection and refraction of light, lenses and mirrors.",
      "topics": [
        "Reflection of Light & Spherical Mirrors",
        "Refraction and Snell's Law",
        "Lens Formula and Magnification"
      ],
      "completed_topics": 2,
      "target_term": "Mid-Term Exam",
      "instructor": "Dr. Rajesh Nambiar",
      "published_to_students": true
    }
  ],
